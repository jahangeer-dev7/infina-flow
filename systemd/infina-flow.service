[Unit]
Description=InfinaFlow - Linux Native Hands-Free Voice Assistant
After=graphical-session.target pipewire.service
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/home/jk/.local/bin/infina-flow
Restart=always
RestartSec=3
PassEnvironment=WAYLAND_DISPLAY XDG_RUNTIME_DIR HYPRLAND_INSTANCE_SIGNATURE
EnvironmentFile=-%h/.config/infina-flow/infina.env

[Install]
WantedBy=graphical-session.target default.target
